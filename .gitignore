# Local virtual environments (do not commit — rebuild with `pip install -r Base/requirements.txt`)
.venv/
.venv_test/
venv/

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Stray debug output from ad-hoc runs outside examples/ (CatBoost writes this
# in the current directory by default; keep only examples/runs/ as the real,
# intentional experiment evidence)
/catboost_info/
/runs/

# Agent outputs when run next to a task.md (default work dir / submission path)
agent_work/
Base/Datasets/**/submission.csv
private_drill/agent_work/
private_drill/submission.csv

# Built platform ZIP — a generated artifact, rebuild with scripts/build_submission.py
/alfa_solution.zip
/alfa_solution.manifest.json
